# Contrato de entorno del portafolio.
#
# Prefijo `VITE_` obligatorio: es el único que Vite expone al cliente. Vite sustituye cada valor
# en tiempo de compilación, así que NADA de esto es secreto una vez publicado el sitio: las
# credenciales de EmailJS son claves públicas por diseño (restringe el dominio en su panel).
#
# MODOS (el nombre dice dónde corre):
#   .env.local.development   `npm run dev`    · ignorado por git  ← tu máquina
#   .env.production          `npm run build`  · ignorado por git  ← solo si compilas en local
# En GitHub Actions los valores salen de `vars`/`secrets` (ver .github/workflows/deployment.yml).
#
# Si falta una variable obligatoria, `npm run dev` y `npm run build` abortan con el listado.

# GENERAL
VITE_APP_APPURL="https://alexchristianqr.github.io/portfolio/"
# Archivo dentro de public/files/
VITE_APP_FILENAME_CV="AlexChristianQuispeRoque-CVSimple-2025-v1.pdf"
# OPCIONAL: sin ID no se carga Google Analytics
VITE_APP_GOOGLE_ANALITYCS=

# PROVEEDOR DE CORREO ELECTRÓNICO (EmailJS)
VITE_APP_EMAILJS_BASE_URL="https://api.emailjs.com/api/v1.0"
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=

# DESTINATARIO DEL FORMULARIO DE CONTACTO
VITE_APP_TO_NAME=
VITE_APP_TO_EMAIL=
